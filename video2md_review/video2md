def resolve_provider(provider: str | None = None) -> str:
    selected = (provider or os.environ.get("VIDEO2MD_PROVIDER") or "qwen").strip().lower()
    aliases = {
        "m3": "minimax",
        "minimax-m3": "minimax",
        "qwen3": "qwen",
        "qwen3.6-35b": "qwen",
        "qwen3.8-27b": "qwen",
        "qwen2.5": "qwen",
        "local": "qwen",
        "gpt": "openai",
    }
    selected = aliases.get(selected, selected)
    if selected not in SUPPORTED_PROVIDERS:
        raise ValueError(f"Unsupported provider: {selected}. 目前仅支持：qwen")
    return selected


